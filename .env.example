# GITHUB_TOKEN: token con permiso de lectura/escritura de contenidos del repo
# (Settings -> Developer settings -> Personal access tokens -> Fine-grained,
#  repo alvarezemiliove-eng/BODA_GEN-EM, permiso Contents: Read and write).
GITHUB_TOKEN=
# Repo y rama donde se guardan las confirmaciones.
GITHUB_REPO=alvarezemiliove-eng/BODA_GEN-EM
GITHUB_BRANCH=main
# Opcional: si se define, el modal debe enviar el mismo valor en el header
# X-Confirm-Token (config.js -> confirmToken). Se deja vacio para abierto.
AUTH_TOKEN=
# Puerto local (Render lo asigna solo).
PORT=3000
